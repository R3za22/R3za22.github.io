# Security headers for static hosts that read _headers (Netlify, Cloudflare Pages). On other hosts set the same values in the server config.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
/sw.js
  Cache-Control: no-cache
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
