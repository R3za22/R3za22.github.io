---
export interface Fact {
  key: string;
  label: string;
  value: string;
  // Links replace the value when present (the links item).
  links?: { label: string; href: string }[];
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<dl class="facts">
  {
    facts.map((fact) => (
      <div class="fact" data-fact={fact.key}>
        <dt class="label">{fact.label}</dt>
        <dd class="value">
          {fact.links && fact.links.length > 0 ? (
            <span class="links">
              {fact.links.map((link) => (
                <a href={link.href} dir="ltr">
                  {link.label} ↗
                </a>
              ))}
            </span>
          ) : (
            <span dir="auto">{fact.value}</span>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
  }

  .fact {
    flex: 1 1 200px;
    min-inline-size: 0;
    margin: 0;
    padding: 18px 20px;
    border-inline-end: 1px solid var(--border);
  }

  .fact:last-child {
    border-inline-end: 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .value {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .links a {
    color: var(--accent);
    text-decoration: none;
  }

  /* Dividers stack vertically once the bar wraps to one item per row. */
  @media (max-width: 600px) {
    .fact {
      border-inline-end: 0;
      border-block-end: 1px solid var(--border);
    }

    .fact:last-child {
      border-block-end: 0;
    }
  }
</style>
