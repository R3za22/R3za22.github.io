---
import { t, type Lang } from '../i18n/ui';
import { alternatePath } from '../i18n/paths';
import { routes } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = lang === 'fa' ? '/fa/' : '/';
const otherLang = lang === 'fa' ? 'en' : 'fa';
const toggleHref = alternatePath(Astro.url.pathname, routes);
const navItems = [
  { href: '#work', label: t(lang, 'nav_work') },
  { href: '#skills', label: t(lang, 'nav_skills') },
  { href: '#experience', label: t(lang, 'nav_experience') },
  { href: '#contact', label: t(lang, 'nav_contact') },
];
---

<header class="container site-header">
  <a class="brand" href={home}>
    {t(lang, 'brand')}<span class="cursor" aria-hidden="true">_</span>
  </a>
  <nav class="nav" aria-label="Primary">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="lang" href={toggleHref} hreflang={otherLang}>{t(lang, 'lang_switch')}</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    padding-block: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .cursor {
    color: var(--accent);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav a.lang {
    color: var(--text);
    border: 1px solid var(--control);
    padding: 6px 10px;
    border-radius: var(--r-tag);
  }
</style>
