---
interface Props {
  label: string;
  height: number;
}

// Reserves the exact image-slot height so a missing screenshot causes no layout shift.
const { label, height } = Astro.props;
---

<div class="placeholder" data-placeholder style={`height:${height}px;min-height:${height}px`}>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    box-sizing: border-box;
    inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    text-align: center;
    background: var(--raised);
    color: var(--dim);
    font-size: 14px;
    overflow: hidden;
  }
</style>
