---
import Placeholder from './Placeholder.astro';

interface Props {
  // One label per frame. The design shows three frames.
  labels: string[];
}

// Frame is 240 x 500 with an 8px bezel, so the screen is 224 x 484. The
// Placeholder gets the exact screen height, so a missing screenshot causes no
// layout shift.
const SCREEN_HEIGHT = 484;

const { labels } = Astro.props;
---

<div class="frames">
  {
    labels.map((label) => (
      <div class="frame" data-phone-frame>
        <Placeholder label={label} height={SCREEN_HEIGHT} />
      </div>
    ))
  }
</div>

<style>
  .frames {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    padding: 40px;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: var(--surface);
  }

  .frame {
    flex: 0 1 240px;
    min-inline-size: 0;
    height: 500px;
    padding: 0;
    border: 8px solid var(--border);
    border-radius: 36px;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .frames {
      padding: 24px;
    }
  }
</style>
