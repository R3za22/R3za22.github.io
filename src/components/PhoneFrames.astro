---
import { Image } from 'astro:assets';
import type { Shot } from '../lib/media';

interface Props {
  shots: Shot[];
}

// Portrait screenshots sit in a phone frame (240px wide). Landscape ones span
// the row in a plain frame. Sizes follow the aspect ratio, so nothing is cropped.
const { shots } = Astro.props;
---

<div class="frames">
  {
    shots.map(({ image, alt }) => {
      const portrait = image.width < image.height;
      return (
        <figure class:list={['frame', portrait ? 'portrait' : 'landscape']} data-phone-frame>
          <Image
            src={image}
            alt={alt}
            widths={[480, 800]}
            sizes={portrait ? '240px' : '(max-width: 720px) 100vw, 800px'}
          />
        </figure>
      );
    })
  }
</div>

<style>
  .frames {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    padding: 40px;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background: var(--surface);
  }

  .frame {
    margin: 0;
    min-inline-size: 0;
    overflow: hidden;
  }

  .frame img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .portrait {
    flex: 0 1 240px;
    padding: 8px;
    border: 8px solid var(--border);
    border-radius: 36px;
  }

  .landscape {
    flex: 1 1 100%;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
  }

  @media (max-width: 600px) {
    .frames {
      padding: 24px;
    }
  }
</style>
