---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import Seo from '../components/Seo.astro';

interface Props {
  lang: 'en' | 'fa';
  title: string;
  description: string;
  alternate: string;
  wide?: boolean;
  jsonLd?: object;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  alternate,
  wide = true,
  jsonLd,
  noindex = false,
} = Astro.props;
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const containerStyle = wide ? undefined : '--container: 1100px';
---

<!doctype html>
<html lang={lang} dir={dir} style={containerStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      lang={lang}
      path={Astro.url.pathname}
      alternate={alternate}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
