---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import FeaturedWork from '../../components/FeaturedWork.astro';
import MoreProjects from '../../components/MoreProjects.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import Timeline from '../../components/Timeline.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import Footer from '../../components/Footer.astro';
import skillsFa from '../../data/skills.fa.json';
import timelineFa from '../../data/timeline.fa.json';
import { personJsonLd, skillSchema, timelineSchema } from '../../lib/schema';
import { t } from '../../i18n/ui';

const lang = 'fa' as const;
const projects = (await getCollection('projects')).filter((project) =>
  project.id.startsWith('fa/'),
);
const skills = skillSchema.parse(skillsFa);
const timeline = timelineSchema.parse(timelineFa);
---

<Base
  lang={lang}
  title="رضا قمر — خانه"
  description={`${t(lang, 'hero_title')} ${t(lang, 'hero_subtitle')}`}
  alternate="/"
  jsonLd={personJsonLd}
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <FeaturedWork lang={lang} projects={projects} />
    <MoreProjects lang={lang} projects={projects} />
    <SkillGrid lang={lang} skills={skills} />
    <Timeline lang={lang} items={timeline} />
    <ContactPanel lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
