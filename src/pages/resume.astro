---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ResumeView from '../components/ResumeView.astro';
import Footer from '../components/Footer.astro';
import skillsEn from '../data/skills.en.json';
import timelineEn from '../data/timeline.en.json';
import { skillSchema, timelineSchema } from '../lib/schema';
import { t } from '../i18n/ui';

const lang = 'en' as const;
const skills = skillSchema.parse(skillsEn);
const timeline = timelineSchema.parse(timelineEn);
---

<Base
  lang={lang}
  title={`${t(lang, 'resume_title')} — ${t(lang, 'val_name')}`}
  description={t(lang, 'resume_description')}
  alternate="/fa/resume"
>
  <Header lang={lang} />
  <main>
    <ResumeView lang={lang} pdfHref="/resume-en.pdf" skills={skills} timeline={timeline} />
  </main>
  <Footer lang={lang} />
</Base>
